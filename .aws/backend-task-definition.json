{
    "family": "personal-web-app-task-definition",
    "containerDefinitions": [
        {
            "name": "backend",
            "image": "913447902637.dkr.ecr.us-east-2.amazonaws.com/personal-web-app-backend",
            "cpu": 0,
            "portMappings": [
                {
                    "name": "backend-5000-tcp",
                    "containerPort": 5000,
                    "hostPort": 5000,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "NODE_ENV",
                    "value": "production"
                },
                {
                    "name": "FRONTEND_URL",
                    "value": "https://geoffthedeov.net"
                },
                {
                    "name": "EMAIL_USER",
                    "value": "geoffrey.murray.1995@gmail.com"
                },
                {
                    "name": "EMAIL_SERVICE",
                    "value": "gmail"
                },
                {
                    "name": "EMAIL_PASS",
                    "value": ""
                },
                {
                    "name": "SF_LOGIN_URL",
                    "value": "https://login.salesforce.com"
                },
                {
                    "name": "SF_USERNAME",
                    "value": "personalwebapp@murrayllc.com"
                },
                {
                    "name": "SF_PASSWORD",
                    "value": ""
                },
                {
                    "name": "SF_CLIENT_ID",
                    "value": ""
                },
                {
                    "name": "SF_PRIVATE_KEY_CONTENT",
                    "value": ""
                },
                {
                    "name": "SYNC_API_KEY",
                    "value": ""
                },
                {
                    "name": "REDIS_URL",
                    "value": "redis://redis.pwa.internal:6379"
                },
                {
                    "name": "EVENT_BUS_GROUP",
                    "value": "backend"
                },
                {
                    "name": "GITHUB_VAULT_REPO",
                    "value": "GeofftheDeov/obsidian-vault"
                },
                {
                    "name": "OBSIDIAN_VAULT_PATH",
                    "value": "/obsidian-vault"
                }
            ],
            "secrets": [
                {
                    "name": "DATABASE_URL",
                    "valueFrom": "arn:aws:secretsmanager:us-east-2:913447902637:secret:personal-web-app/prod/DATABASE_URL-NyKmZU"
                },
                {
                    "name": "VAULT_ENCRYPTION_KEY",
                    "valueFrom": "arn:aws:secretsmanager:us-east-2:913447902637:secret:personal-web-app/prod/VAULT_ENCRYPTION_KEY-tcoUO8"
                },
                {
                    "name": "JWT_SECRET",
                    "valueFrom": "arn:aws:secretsmanager:us-east-2:913447902637:secret:personal-web-app/prod/JWT_SECRET-TmWcTT"
                },
                {
                    "name": "ANTHROPIC_API_KEY",
                    "valueFrom": "arn:aws:secretsmanager:us-east-2:913447902637:secret:personal-web-app/prod/ANTHROPIC_API_KEY-WWOI3M"
                },
                {
                    "name": "ALPACA_API_KEY",
                    "valueFrom": "arn:aws:secretsmanager:us-east-2:913447902637:secret:personal-web-app/prod/ALPACA_API_KEY-oXyW3K"
                },
                {
                    "name": "ALPACA_SECRET_KEY",
                    "valueFrom": "arn:aws:secretsmanager:us-east-2:913447902637:secret:personal-web-app/prod/ALPACA_SECRET_KEY-efJBQq"
                },
                {
                    "name": "VAULT_TOKEN",
                    "valueFrom": "arn:aws:secretsmanager:us-east-2:913447902637:secret:personal-web-app/prod/VAULT_TOKEN-6WwXXY"
                }
            ],
            "environmentFiles": [],
            "mountPoints": [
                {
                    "sourceVolume": "obsidian-vault",
                    "containerPath": "/obsidian-vault",
                    "readOnly": false
                }
            ],
            "volumesFrom": [],
            "ulimits": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/personal-web-app-task-definition",
                    "awslogs-create-group": "true",
                    "awslogs-region": "us-east-2",
                    "awslogs-stream-prefix": "ecs"
                },
                "secretOptions": []
            },
            "systemControls": []
        },
        {
            "name": "frontend",
            "image": "913447902637.dkr.ecr.us-east-2.amazonaws.com/personal-web-app-frontend",
            "cpu": 0,
            "portMappings": [
                {
                    "name": "frontend-http",
                    "containerPort": 3000,
                    "hostPort": 3000,
                    "protocol": "tcp",
                    "appProtocol": "http"
                },
                {
                    "name": "frontend-https",
                    "containerPort": 3001,
                    "hostPort": 3001,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": false,
            "environment": [
                {
                    "name": "BACKEND_URL",
                    "value": "http://localhost:5000"
                }
            ],
            "environmentFiles": [],
            "mountPoints": [],
            "volumesFrom": [],
            "systemControls": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/personal-web-app-task-definition",
                    "awslogs-create-group": "true",
                    "awslogs-region": "us-east-2",
                    "awslogs-stream-prefix": "ecs"
                },
                "secretOptions": []
            }
        }
    ],
    "volumes": [
        {
            "name": "obsidian-vault",
            "efsVolumeConfiguration": {
                "fileSystemId": "fs-0823aab1d7700df09",
                "transitEncryption": "ENABLED",
                "authorizationConfig": {
                    "accessPointId": "fsap-004dad744f7588eda",
                    "iam": "ENABLED"
                }
            }
        }
    ],
    "taskRoleArn": "arn:aws:iam::913447902637:role/ecsTaskRole",
    "executionRoleArn": "arn:aws:iam::913447902637:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "1024",
    "memory": "3072",
    "runtimePlatform": {
        "cpuArchitecture": "ARM64",
        "operatingSystemFamily": "LINUX"
    }
}